 "steps": [
  {
   "type": "plug",
   "title": "Plug the diathermy generator into the pendant",
   "item": "esu_power",
   "hint": "Mains lead from the generator into a socket on the ceiling pendant.",
   "id": "caesarean-s1"
  },
  {
   "type": "choose",
   "title": "Where does the patient plate go?",
   "prompt": "Where should the return electrode (patient plate) be placed?",
   "choices": [
    {
     "text": "On a well-perfused muscle mass close to the operation, such as the thigh, on dry hair-free skin",
     "correct": true,
     "feedback": "Correct: a large, well-perfused contact area keeps the current density low."
    },
    {
     "text": "Over a bony prominence",
     "correct": false,
     "feedback": "Poor contact: a burn risk at the plate.",
     "critical": false
    },
    {
     "text": "Over a metal implant",
     "correct": false,
     "feedback": "Current concentrates in the metal.",
     "critical": true
    },
    {
     "text": "Anywhere on the patient",
     "correct": false,
     "feedback": "Distance and contact both matter.",
     "critical": false
    }
   ],
   "hint": "",
   "id": "caesarean-s2"
  },
  {
   "type": "plug",
   "title": "Apply the patient plate to the thigh",
   "item": "return_pad",
   "hint": "Full, flat contact on the thigh; check the generator's contact alarm clears.",
   "id": "caesarean-s3"
  },
  {
   "type": "plug",
   "title": "Connect the suction to the wall vacuum",
   "item": "suction_vacuum",
   "hint": "Canister tubing to the yellow vacuum outlet on the pendant.",
   "id": "caesarean-s4"
  },
  {
   "type": "plug",
   "title": "Plug in the suction unit",
   "item": "suction_power",
   "hint": "",
   "id": "caesarean-s5"
  },
  {
   "type": "choose",
   "title": "WHO Time Out",
   "prompt": "Before skin incision for a caesarean section, the team pauses. What must be confirmed aloud?",
   "choices": [
    {
     "text": "Patient identity, the procedure, the site and side, and antibiotics given in the last 60 minutes",
     "correct": true,
     "feedback": "Correct: the Time Out confirms who, what and where, and that prophylaxis is in."
    },
    {
     "text": "Only that the consent form is signed",
     "correct": false,
     "feedback": "The signature alone does not prevent wrong-site surgery.",
     "critical": false
    },
    {
     "text": "Nothing: the site was marked on the ward",
     "correct": false,
     "feedback": "Marking does not replace the Time Out.",
     "critical": true
    }
   ],
   "hint": "The site is the lower abdomen. All three phases of the WHO checklist are mandatory.",
   "id": "caesarean-s6"
  },
  {
   "type": "pick",
   "title": "Pick up the skin preparation",
   "item": "disinfectant_a01",
   "hint": "Alcoholic chlorhexidine, applied from the incision site outwards.",
   "wrongItems": [],
   "critical": false,
   "id": "caesarean-s7"
  },
  {
   "type": "apply",
   "title": "Prepare the skin over the lower abdomen",
   "item": "disinfectant_a01",
   "target": "suprapubic",
   "hint": "Centre outwards, wider than the incision; let it dry fully before drapes and diathermy (it is flammable).",
   "hold": 2.0,
   "critical": false,
   "id": "caesarean-s8"
  },
  {
   "type": "pick",
   "title": "Take the scalpel",
   "item": "instrument_scalpel_handle_a01",
   "hint": "Pfannenstiel incision, two fingers above the symphysis.",
   "wrongItems": [],
   "critical": false,
   "id": "caesarean-s9"
  },
  {
   "type": "apply",
   "title": "Transverse suprapubic incision",
   "item": "instrument_scalpel_handle_a01",
   "target": "suprapubic",
   "hint": "Curved, in the skin crease.",
   "hold": 1.5,
   "critical": false,
   "id": "caesarean-s10"
  },
  {
   "type": "pick",
   "title": "Bladder retractor",
   "item": "instrument_retractor_a01",
   "hint": "Reflect and protect the bladder.",
   "wrongItems": [],
   "critical": false,
   "id": "caesarean-s11"
  },
  {
   "type": "choose",
   "title": "Uterine incision",
   "prompt": "The uterus is opened…",
   "choices": [
    {
     "text": "Transversely in the lower segment",
     "correct": true,
     "feedback": "Correct: less bleeding, stronger scar."
    },
    {
     "text": "Vertically through the fundus",
     "correct": false,
     "feedback": "Classical incision: high rupture risk.",
     "critical": false
    },
    {
     "text": "Anywhere convenient",
     "correct": false,
     "feedback": "No.",
     "critical": false
    }
   ],
   "hint": "",
   "id": "caesarean-s12"
  },
  {
   "type": "operate",
   "title": "Suction ready for liquor",
   "item": "pump_suction_surgical_a01",
   "joint": "",
   "open": true,
   "hint": "",
   "id": "caesarean-s13"
  },
  {
   "type": "confirm",
   "title": "Deliver the baby and the placenta",
   "hint": "Note the time; hand the baby to the midwife/neonatologist.",
   "id": "caesarean-s14"
  },
  {
   "type": "pick",
   "title": "Give the uterotonic",
   "item": "syringe_a01",
   "hint": "Oxytocin as per protocol.",
   "wrongItems": [],
   "critical": false,
   "id": "caesarean-s15"
  },
  {
   "type": "choose",
   "title": "Postpartum haemorrhage",
   "prompt": "Heavy bleeding after delivery. First actions?",
   "choices": [
    {
     "text": "Uterine massage, uterotonics, tranexamic acid, call for help",
     "correct": true,
     "feedback": "Correct."
    },
    {
     "text": "Wait and see",
     "correct": false,
     "feedback": "PPH kills quickly.",
     "critical": false
    },
    {
     "text": "Close quickly and leave",
     "correct": false,
     "feedback": "Bleeding continues.",
     "critical": false
    }
   ],
   "hint": "",
   "id": "caesarean-s16"
  }
 ],
 "errorPenalty": 10,
 "hintPenalty": 3
