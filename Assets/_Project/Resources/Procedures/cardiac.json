 "steps": [
  {
   "type": "plug",
   "title": "Plug in the patient monitor",
   "item": "mon_power",
   "hint": "",
   "id": "cardiac-s1"
  },
  {
   "type": "plug",
   "title": "Clip the oximeter probe on a finger",
   "item": "spo2",
   "hint": "Pulse oximetry first: it is part of the WHO Sign In.",
   "id": "cardiac-s2"
  },
  {
   "type": "plug",
   "title": "Attach the ECG leads to the chest",
   "item": "ecg",
   "hint": "Electrodes on the chest wall, away from the operative field.",
   "id": "cardiac-s3"
  },
  {
   "type": "plug",
   "title": "Put the blood pressure cuff on the arm",
   "item": "nibp",
   "hint": "Right arm, cuff 2 cm above the elbow; not on the arm with the drip.",
   "id": "cardiac-s4"
  },
  {
   "type": "choose",
   "title": "Recognise",
   "prompt": "6 h after CABG: BP falling, CVP rising, drains suddenly stop. Suspect…",
   "choices": [
    {
     "text": "Cardiac tamponade",
     "correct": true,
     "feedback": "Correct."
    },
    {
     "text": "Hypovolaemia",
     "correct": false,
     "feedback": "CVP would fall.",
     "critical": false
    },
    {
     "text": "Normal recovery",
     "correct": false,
     "feedback": "No.",
     "critical": false
    }
   ],
   "hint": "",
   "id": "cardiac-s5"
  },
  {
   "type": "operate",
   "title": "Check the chest drains",
   "item": "drainage_pumpSystem_a01",
   "joint": "",
   "open": true,
   "hint": "Blocked drains can cause tamponade.",
   "id": "cardiac-s6"
  },
  {
   "type": "pick",
   "title": "Echo to confirm",
   "item": "ultrasound_a01",
   "hint": "",
   "wrongItems": [],
   "critical": false,
   "id": "cardiac-s7"
  },
  {
   "type": "apply",
   "title": "Subxiphoid view",
   "item": "ultrasound_a01",
   "target": "subxiphoid",
   "hint": "Pericardial collection, right-sided collapse.",
   "hold": 2.0,
   "critical": false,
   "id": "cardiac-s8"
  },
  {
   "type": "choose",
   "title": "Management",
   "prompt": "Tamponade with haemodynamic compromise after cardiac surgery needs…",
   "choices": [
    {
     "text": "Urgent re-sternotomy",
     "correct": true,
     "feedback": "Correct."
    },
    {
     "text": "More fluids and observation only",
     "correct": false,
     "feedback": "Temporises at best.",
     "critical": false
    },
    {
     "text": "Discharge from ICU",
     "correct": false,
     "feedback": "No.",
     "critical": true
    }
   ],
   "hint": "",
   "id": "cardiac-s9"
  },
  {
   "type": "operate",
   "title": "Open the defibrillator lid, pads ready",
   "item": "defibrillator_a01",
   "joint": "",
   "open": true,
   "hint": "In case of arrest: follow the cardiac surgery arrest protocol (CALS).",
   "id": "cardiac-s10"
  },
  {
   "type": "apply",
   "title": "Sternum: the re-opening site",
   "item": "",
   "target": "sternum",
   "hint": "Re-sternotomy within 5 minutes of arrest after cardiac surgery.",
   "hold": 1.5,
   "id": "cardiac-s11"
  }
 ],
