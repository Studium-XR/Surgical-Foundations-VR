 "steps": [
  {
   "type": "choose",
   "title": "Before you plug anything in",
   "prompt": "Which check comes first when setting up electrical equipment in theatre?",
   "choices": [
    {
     "text": "Check the equipment is serviced, undamaged and the leads intact",
     "correct": true,
     "feedback": "Correct: damaged leads and out-of-date equipment are taken out of use."
    },
    {
     "text": "Turn everything to maximum to test it",
     "correct": false,
     "feedback": "Never: test at safe settings.",
     "critical": false
    },
    {
     "text": "Nothing: biomedical engineering checked it",
     "correct": false,
     "feedback": "You check before each use too.",
     "critical": false
    }
   ],
   "hint": "",
   "id": "theatre-setup-s1"
  },
  {
   "type": "plug",
   "title": "Plug in the patient monitor",
   "item": "mon_power",
   "hint": "",
   "id": "theatre-setup-s2"
  },
  {
   "type": "plug",
   "title": "Clip the oximeter probe on a finger",
   "item": "spo2",
   "hint": "Pulse oximetry first: it is part of the WHO Sign In.",
   "id": "theatre-setup-s3"
  },
  {
   "type": "plug",
   "title": "Attach the ECG leads to the chest",
   "item": "ecg",
   "hint": "Electrodes on the chest wall, away from the operative field.",
   "id": "theatre-setup-s4"
  },
  {
   "type": "plug",
   "title": "Put the blood pressure cuff on the arm",
   "item": "nibp",
   "hint": "Right arm, cuff 2 cm above the elbow; not on the arm with the drip.",
   "id": "theatre-setup-s5"
  },
  {
   "type": "plug",
   "title": "Plug the diathermy generator into the pendant",
   "item": "esu_power",
   "hint": "Mains lead from the generator into a socket on the ceiling pendant.",
   "id": "theatre-setup-s6"
  },
  {
   "type": "choose",
   "title": "Where does the patient plate go?",
   "prompt": "Where should the return electrode (patient plate) be placed?",
   "choices": [
    {
     "text": "On a well-perfused muscle mass close to the operation, such as the thigh, on dry hair-free skin",
     "correct": true,
     "feedback": "Correct: a large, well-perfused contact area keeps the current density low."
    },
    {
     "text": "Over a bony prominence",
     "correct": false,
     "feedback": "Poor contact: a burn risk at the plate.",
     "critical": false
    },
    {
     "text": "Over a metal implant",
     "correct": false,
     "feedback": "Current concentrates in the metal.",
     "critical": true
    },
    {
     "text": "Anywhere on the patient",
     "correct": false,
     "feedback": "Distance and contact both matter.",
     "critical": false
    }
   ],
   "hint": "",
   "id": "theatre-setup-s7"
  },
  {
   "type": "plug",
   "title": "Apply the patient plate to the thigh",
   "item": "return_pad",
   "hint": "Full, flat contact on the thigh; check the generator's contact alarm clears.",
   "id": "theatre-setup-s8"
  },
  {
   "type": "plug",
   "title": "Connect the suction to the wall vacuum",
   "item": "suction_vacuum",
   "hint": "Canister tubing to the yellow vacuum outlet on the pendant.",
   "id": "theatre-setup-s9"
  },
  {
   "type": "plug",
   "title": "Plug in the suction unit",
   "item": "suction_power",
   "hint": "",
   "id": "theatre-setup-s10"
  },
  {
   "type": "plug",
   "title": "Plug in the laparoscopic tower",
   "item": "tower_power",
   "hint": "",
   "id": "theatre-setup-s11"
  },
  {
   "type": "plug",
   "title": "Connect the light cable to the laparoscope",
   "item": "light",
   "hint": "Light lead to the scope's light post at the camera port.",
   "id": "theatre-setup-s12"
  },
  {
   "type": "plug",
   "title": "Connect the camera head",
   "item": "camera",
   "hint": "White balance before inserting the scope.",
   "id": "theatre-setup-s13"
  },
  {
   "type": "plug",
   "title": "Connect the CO2 tubing to the camera port",
   "item": "co2",
   "hint": "Insufflation at 12-15 mmHg once the port is in the peritoneal cavity.",
   "id": "theatre-setup-s14"
  },
  {
   "type": "operate",
   "title": "Switch the suction on and check it pulls",
   "item": "pump_suction_surgical_a01",
   "joint": "",
   "open": true,
   "hint": "Occlude the tubing: the vacuum gauge should rise.",
   "id": "theatre-setup-s15"
  },
  {
   "type": "choose",
   "title": "Ready",
   "prompt": "Everything is connected. What do you confirm before the patient comes in?",
   "choices": [
    {
     "text": "Alarms on, plate contact alarm clear, suction working, tower image white-balanced",
     "correct": true,
     "feedback": "Correct."
    },
    {
     "text": "Only that the lights work",
     "correct": false,
     "feedback": "Not enough.",
     "critical": false
    },
    {
     "text": "Nothing: the surgeon will check",
     "correct": false,
     "feedback": "The whole team owns the set-up.",
     "critical": false
    }
   ],
   "hint": "",
   "id": "theatre-setup-s16"
  }
 ],
 "errorPenalty": 10,
 "hintPenalty": 3
}